{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "dialog:default",
    "fs:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    {
      "identifier": "fs:scope-app-recursive",
      "allow": ["**"]
    }
  ]
}
